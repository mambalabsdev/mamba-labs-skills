      ],
      "anchors": [
        "projected at the stated volume"
      ]
    },
    {
      "id": "cap",
      "prompt": "Run it on everyone.",
      "assert": [
        "sets a credit cap"
      ],
      "anchors": [
        "hard credit cap is set"
      ]
    }
  ]
}