      "prompt": "Set the floor at 5000.",
      "assert": [
        "justifies the floor against the offer price"
      ],
      "anchors": [
        "justified against the offer price"
      ]
    },
    {
      "id": "repeat-winners",
      "prompt": "Some names appear every year.",
      "assert": [
        "identifies repeat winners separately"
      ],
      "anchors": [
        "Repeat winners are identified separately"
      ]
    }
  ]
